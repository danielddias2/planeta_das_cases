# ==============================================================================
# PLANETA DAS CASES - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO / DESENVOLVIMENTO
# ==============================================================================
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto.
# NUNCA insira sua Service Role Key ou credenciais confidenciais neste arquivo!
# ==============================================================================

# 1. Supabase - Conexão Pública (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Atendimento Comercial (WhatsApp Oficial)
# Formato: apenas números com DDI + DDD (exemplo: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# 3. URL Pública da Aplicação (para Sitemap, Robots e Metadados OpenGraph)
# Exemplo em desenvolvimento: http://localhost:3000
# Exemplo em produção: https://seu-app.vercel.app ou https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=
